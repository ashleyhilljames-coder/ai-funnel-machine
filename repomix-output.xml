  if (isClient) {
  const cleanClient = clientId.toLowerCase().trim();
  let allowedDefaultIds: string[] = [];
  if (cleanClient === 'restoration_lv') allowedDefaultIds = ['mitigation'];
  else if (cleanClient === 'roofing_sc') allowedDefaultIds = ['roofing'];
  else if (cleanClient === 'property_apex') allowedDefaultIds = ['property'];
  else if (cleanClient === 'realestate_nexus') allowedDefaultIds = ['realestate'];
  else allowedDefaultIds = ['mitigation', 'roofing', 'property', 'realestate'];

  const placeholders = allowedDefaultIds.map(() => '?').join(',');

  const query = this.db.prepare(`
  SELECT * FROM outbound_templates WHERE client_id = ?
  UNION ALL
  SELECT * FROM outbound_templates WHERE client_id = 'default_client'
  AND id IN (${placeholders})
  AND id NOT IN (SELECT id FROM outbound_templates WHERE client_id = ?)
  ORDER BY id ASC
  `);
  return query.all(cleanClient, ...allowedDefaultIds, cleanClient) as any[];
  }
  return this.db.prepare("SELECT * FROM outbound_templates WHERE client_id = 'default_client'ORDER BY id ASC").all() as any[];
  } catch (err) {
  console.error("Failed to query outbound templates:", err);
  return [];
  }
