 messages.push({ role: 'user', content: json.text });
 
 await handleChatCompletion(ws, callId, clientId, messages);
 }
 } catch (err: any) {
 console.error('Chat message error:', err);
 ws.send(JSON.stringify({ event: 'error', message: 'Error processing message'}));
 }
 });

 ws.on('close', () =>{
