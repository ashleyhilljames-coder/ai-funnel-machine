    emailOrData: string | { email: string; name?: string; phone?: string; extractedTraits?: string; observations?: string },
    name?: string,
    phone?: string,
    traits?: any,
    observation?: string
  ) {
    let email: string;
    let finalName: string = '';
    let finalPhone: string = '';
    let finalTraits: any = null;
    let finalObservation: string | undefined = undefined;

    if (typeof emailOrData === 'object' && emailOrData !== null) {
      email = emailOrData.email;
      finalName = emailOrData.name ?? '';
      finalPhone = emailOrData.phone ?? '';
      const timestamp = new Date().toISOString();
      const existing = this.db.prepare(`SELECT * FROM customer_profiles WHERE email = ?`).get(email) as any;
      
      const traitsStr = emailOrData.extractedTraits ?? '{}';
      const obsStr = emailOrData.observations ?? '[]';

      if (existing) {
        const update = this.db.prepare(`
          UPDATE customer_profiles
          SET name = ?, phone = ?, extracted_traits = ?, observations = ?, updated_at = ?
          WHERE email = ?
        `);
        update.run(finalName || existing.name, finalPhone || existing.phone, traitsStr, obsStr, timestamp, email);
      } else {
        const profileId = crypto.randomUUID();
        const insert = this.db.prepare(`
          INSERT INTO customer_profiles (id, email, name, phone, extracted_traits, observations, updated_at)
          VALUES (?, ?, ?, ?, ?, ?, ?)
        `);
        insert.run(profileId, email, finalName, finalPhone, traitsStr, obsStr, timestamp);
      }
      return;
    } else {
      email = emailOrData;
      finalName = name ?? '';
      finalPhone = phone ?? '';
      finalTraits = traits;
      finalObservation = observation;
    }

    try {
      const timestamp = new Date().toISOString();
      const existing = this.db.prepare(`SELECT * FROM customer_profiles WHERE email = ?`).get(email) as any;

      let finalTraitsStr = '{}';
      let finalObservationsStr = '[]';

      if (existing) {
        // Merge traits
        let existingTraits: any = {};
        if (existing.extracted_traits) {
          try {
            existingTraits = JSON.parse(existing.extracted_traits);
          } catch (_) {}
        }
        
        let newTraits: any = {};
        if (finalTraits) {
          if (typeof finalTraits === 'string') {
            try {
              newTraits = JSON.parse(finalTraits);
            } catch (_) {
              newTraits = { raw_traits: finalTraits };
            }
          } else {
            newTraits = finalTraits;
          }
        }
        
        const mergedTraits = { ...existingTraits, ...newTraits };
        finalTraitsStr = JSON.stringify(mergedTraits);

        // Merge observations
        let observationsList: string[] = [];
        if (existing.observations) {
          try {
            observationsList = JSON.parse(existing.observations);
          } catch (_) {}
        }

        if (finalObservation && finalObservation.trim()) {
          if (!observationsList.includes(finalObservation)) {
            observationsList.push(finalObservation);
          }
        }
        finalObservationsStr = JSON.stringify(observationsList);

        const updatedName = finalName !== undefined && finalName !== '' ? finalName : existing.name;
        const updatedPhone = finalPhone !== undefined && finalPhone !== '' ? finalPhone : existing.phone;

        const update = this.db.prepare(`
          UPDATE customer_profiles
          SET name = ?, phone = ?, extracted_traits = ?, observations = ?, updated_at = ?
          WHERE email = ?
        `);
        update.run(updatedName, updatedPhone, finalTraitsStr, finalObservationsStr, timestamp, email);
      } else {
        // Insert new profile
        let newTraits: any = {};
        if (finalTraits) {
          if (typeof finalTraits === 'string') {
            try {
              newTraits = JSON.parse(finalTraits);
            } catch (_) {
              newTraits = { raw_traits: finalTraits };
            }
          } else {
            newTraits = finalTraits;
          }
