              <p><strong>Job ID:</strong> ${newJob.id}</p>
              <p><strong>Homeowner:</strong> ${newJob.homeowner_name} (${newJob.homeowner_phone})</p>
              <p><strong>Address:</strong> ${newJob.address}</p>
              <p><strong>Damage Type:</strong> ${newJob.damage_type}</p>
