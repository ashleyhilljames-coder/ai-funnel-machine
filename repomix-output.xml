 try {
 const cleanEmail = email.toLowerCase().trim();
 const cleanClient = clientId.toLowerCase().trim();
 const update = this.db.prepare(`
 UPDATE lead_registry 
 SET status = ? 
 WHERE email = ? AND client_id = ?
 `);
