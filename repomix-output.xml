          });
        }
      } catch (parseErr: any) {
        console.warn(`⚠️ [CRAIGSLIST SCRAPER] RSS XML parse failed (${parseErr.message}). Fallback to HTML string parser...`);
        const parsedHtmlLeads = parseCraigslistHtml(xml);
