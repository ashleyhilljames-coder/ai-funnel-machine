  jobs: MissionJob[];
  selectedJobId?: string;
  onSelectJob: (jobId: string) => void;
  onRefreshData: () => void;
}

export const MobileTechView: React.FC<MobileTechViewProps> = ({
  jobs,
  selectedJobId,
  onSelectJob,
  onRefreshData
}) => {
