# Server & Environment Configuration
PORT=3000
NODE_ENV=development
PUBLIC_URL=https://your-domain.ngrok-free.dev
ADMIN_PASSWORD=your_admin_password_here
DEFAULT_CLIENT_PASSWORD=your_default_client_password_here
SYNCRO_SCALE_API_KEY=your_syncro_scale_api_key_here

# Supabase Database Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_PASSWORD=your_supabase_password_here

# Twilio & Telephony Configuration
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+15551234567

# Google Cloud & Pub/Sub Configuration
GOOGLE_CLOUD_PROJECT=your_gcp_project_id
PUBSUB_TOPIC=leads
PUBSUB_SUBSCRIPTION=leads-sub
GOOGLE_APPLICATION_CREDENTIALS=./gcp-key.json
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Google Calendar Configuration
GOOGLE_CALENDAR_ID=your_email@domain.com
SKIP_CALENDAR_BOOKING=false

# AI Provider API Keys
OPENAI_API_KEY=sk-proj-your_openai_api_key_here
ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Email & Outreach
RESEND_API_KEY=re_your_resend_api_key_here

# Webhooks & Integrations
ELEVENLABS_WEBHOOK_SECRET=your_elevenlabs_webhook_secret_here
DISPATCH_WEBHOOK_URL=https://your-webhook-endpoint.com
