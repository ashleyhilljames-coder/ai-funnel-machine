# Gemini API Key (Required for AI lead qualification)
GEMINI_API_KEY=your_gemini_api_key_here

# Slack Webhook URL (Optional: Set either SLACK_WEBHOOK_URL or DISCORD_WEBHOOK_URL)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK_URL

# Discord Webhook URL (Optional)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR/DISCORD/WEBHOOK_URL

# Polling Configuration
POLLING_INTERVAL_MINUTES=15
MAX_ITEMS_PER_BATCH=10

# RSS Feeds to monitor (comma-separated URLs). If left empty, default home relief RSS feeds are used.
RSS_FEEDS=https://www.reddit.com/r/LasVegas/search.rss?q=plumber+OR+leak+OR+flood+OR+repair&restrict_sr=1&sort=new,https://www.reddit.com/r/HomeImprovement/search.rss?q=emergency+OR+leak+OR+plumber+OR+flood&restrict_sr=1&sort=new
