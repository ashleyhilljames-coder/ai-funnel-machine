# Gemini API Key (Required for AI lead qualification)
GEMINI_API_KEY=your_gemini_api_key_here

# Slack Webhook URL (Optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK_URL

# Discord Webhook URL (#leads - RHR Triage)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR/DISCORD/WEBHOOK_URL

# EcoDry Discord Webhook URL (#ecodry-live-leads - EcoDry Dispatch)
ECODRY_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR/ECODRY/DISCORD/WEBHOOK_URL

# Polling Configuration
POLLING_INTERVAL_MINUTES=4
MAX_ITEMS_PER_BATCH=10

# RSS Feeds to monitor (comma-separated URLs)
RSS_FEEDS=https://www.reddit.com/r/LasVegas+HendersonNV+NorthLasVegas+SpringValleyNV+CentennialHills/search.rss?q=plumber+OR+leak+OR+flood+OR+repair&restrict_sr=1&sort=new
